# Bitget AI Hackathon environment example
#
# Copy this file to `.env` locally if a tool explicitly needs environment variables.
# Never commit `.env` or real secrets.
#
# Current project code is backtest-only and does not require these values.
# Keep trading disabled unless a separate live-trading implementation plan is approved.

# Required only for authenticated Bitget account/trading API calls.
BITGET_API_KEY="<YOUR_BITGET_API_KEY>"
BITGET_SECRET_KEY="<YOUR_BITGET_SECRET_KEY>"
BITGET_PASSPHRASE="<YOUR_BITGET_PASSPHRASE>"

# Optional Playbook credential, only if the official Playbook flow asks for it.
PLAYBOOK_API_KEY="<YOUR_PLAYBOOK_API_KEY>"

# Safety switches for future code. Do not change these to true without explicit approval.
BITGET_READ_ONLY="true"
ENABLE_LIVE_TRADING="false"
ENABLE_ORDER_PLACEMENT="false"
